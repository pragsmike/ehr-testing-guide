{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        metosin/malli {:mvn/version "0.16.4"}
        org.clojure/test.check {:mvn/version "1.1.1"}}

 :aliases
 {;; Test runner. Kept minimal and dependency-light so `clojure -X:test`
  ;; stays fast; do not add HAPI or other heavyweight deps here.
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :exec-fn cognitect.test-runner.api/test}

  ;; REPL/CIDER development. Jack in with this alias (e.g. `clojure -M:dev`
  ;; or your editor's jack-in command configured to include :dev).
  :dev {:extra-paths ["test"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                     cider/cider-nrepl {:mvn/version "0.50.2"}}
        :main-opts ["-m" "nrepl.cmdline" "--middleware"
                    "[cider.nrepl/cider-middleware]"]}

  ;; HAPI FHIR and HAPI HL7v2 are separated into their own alias, not the
  ;; base :deps, because they pull in a large Java dependency graph
  ;; (Maven-central resolution + jar download can take minutes on a cold
  ;; cache). The base project and `make test` must resolve and run fast
  ;; without them; add `-A:hapi` only when a listing actually needs them.
  :hapi {:extra-deps {ca.uhn.hapi.fhir/hapi-fhir-base {:mvn/version "8.6.0"}
                       ca.uhn.hapi.fhir/hapi-fhir-structures-r4 {:mvn/version "8.6.0"}
                       ca.uhn.hapi/hapi-base {:mvn/version "2.5.1"}
                       ca.uhn.hapi/hapi-structures-v24 {:mvn/version "2.5.1"}}}}}
